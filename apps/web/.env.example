# Browser calls go through Next.js rewrites (/api → FastAPI). Leave this empty
# unless you intentionally want cross-origin API calls (also set USE_DIRECT).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_USE_DIRECT=true

# Origin for Next.js server-side rewrites (dev proxy target).
MASMS_API_ORIGIN=http://127.0.0.1:8000

NEXT_PUBLIC_DEFAULT_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
NEXT_PUBLIC_DEFAULT_ACTOR_ID=00000000-0000-4000-8000-000000000101
