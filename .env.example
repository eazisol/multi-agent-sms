# MASMS local/dev example values — never put real secrets here.
# Copy to `.env` for local use. Runtime secrets belong in the approved secret manager.

MASMS_ENV=local
MASMS_API_TITLE=MASMS API
MASMS_API_VERSION=0.1.0
MASMS_DATABASE_URL=postgresql+psycopg://masms:masms_dev_only@localhost:5432/masms
# SQLite fallback for offline unit/API smoke tests only (no RLS):
# MASMS_DATABASE_URL=sqlite+pysqlite:///:memory:
MASMS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
MASMS_DEFAULT_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# local_env | secrets_manager — production must use secrets_manager
MASMS_SECRET_BACKEND=local_env
# local | auth0 — local keeps opaque sessions and development identity headers.
MASMS_AUTH_PROVIDER=local
# Set true to reject development X-Actor-* identity headers.
MASMS_DISABLE_HEADER_IDENTITY=false
# MASMS_AUTH0_DOMAIN=your-tenant.auth0.com
# MASMS_AUTH0_AUDIENCE=https://api.masms.local

# Empty Temporal address keeps the deterministic stub adapter.
# MASMS_TEMPORAL_ADDRESS=localhost:7233
MASMS_TEMPORAL_NAMESPACE=default
MASMS_TEMPORAL_TASK_QUEUE=masms-local

# Empty provider keys keep stub agent/retrieval adapters. Never commit real keys.
# MASMS_OPENAI_API_KEY=
MASMS_OPENAI_MODEL=gpt-4.1-mini
# MASMS_EMBEDDING_MODEL=text-embedding-3-small

# sim is the safe default. live requires sandbox credentials via credential_ref.
MASMS_GMAIL_MODE=sim
MASMS_JIRA_MODE=sim
# MASMS_JIRA_BASE_URL=https://your-sandbox.atlassian.net
# MASMS_JIRA_PROJECT_KEY=SANDBOX
# MASMS_JIRA_CREDENTIAL_REF=secrets/jira_sandbox
# A local credential_ref `secrets/jira_sandbox` resolves from:
# MASMS_SECRET_JIRA_SANDBOX={"email":"...","api_token":"...","webhook_secret":"..."}
# Gmail connection refs resolve the same way, for example secrets/gmail_sandbox
# → MASMS_SECRET_GMAIL_SANDBOX with OAuth token JSON.

# MASMS_AWS_REGION=us-east-1
# MASMS_SECRETS_PREFIX=masms/local
